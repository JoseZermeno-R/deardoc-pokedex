{
  "name": "deardoc-pokedex",
  "private": true,
  "description": "Pokédex fullstack code challenge: NestJS + SQLite REST API and a React frontend.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10"
  }
}
